# Kopiér denne fil til ".env" og udfyld den. Filen må ALDRIG lægges på GitHub.
# (.gitignore sørger allerede for det.)

# ---------------------------------------------------------------- adgang --
# Adgangskoden til appen. Vælg noget langt du kan huske. Mindst 10 tegn.
APP_PASSWORD=

# En tilfældig streng der holder dig logget ind på tværs af genstarter.
# Lav en med:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------- Claude --
# Hentes på https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# --------------------------------------------------------------- Stripe ---
# Brug en BEGRÆNSET nøgle (starter med rk_), ikke din hemmelige hovednøgle:
# Stripe → Developers → API keys → "Create restricted key".
# Sæt ALT til "Read" og lad alt andet stå på "None".
# Programmet kan under ingen omstændigheder flytte penge, men en read-only
# nøgle betyder at det heller ikke er teknisk muligt.
STRIPE_SECRET_KEY=

# -------------------------------------------------- GoHighLevel / Agencyflow
# Settings → Private Integrations → "Create new integration".
# Nødvendige scopes (læsning):
#   contacts.readonly, objects/record.readonly, opportunities.readonly,
#   invoices.readonly, payments/transactions.readonly,
#   payments/subscriptions.readonly, locations/customFields.readonly,
#   calendars/events.readonly
# Hvis chatten også skal kunne skrive noter og opgaver:
#   contacts.write, objects/record.write
# (Kontrakter kræver derudover scope til documents/contracts, hvis din konto har det.)
GHL_API_KEY=

# Location-id'et står i adresselinjen inde i GoHighLevel: .../location/<ID>/...
GHL_LOCATION_ID=

# Sæt til false hvis chatten kun må læse, aldrig skrive.
GHL_ALLOW_WRITES=true

# Valgfrit: nogle konti kræver et bruger-id på noter og opgaver.
GHL_USER_ID=

# Bruger du en white-label-adresse (Agencyflow), kan basis-URL'en skiftes her.
# GHL_BASE_URL=https://services.leadconnectorhq.com

# ------------------------------------------------------------------ andet --
BUSINESS_NAME=
TIMEZONE=Europe/Copenhagen
CURRENCY=DKK
PORT=8080
