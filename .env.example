# ─── Required in production ────────────────────────────────────────────────
# Encrypts provider access tokens at rest (AES-256-GCM). Without it, Kroner
# refuses to store any provider credential — demo mode still works.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# PostgreSQL connection string. Supabase, RDS, Neon, or a local server.
# Leave unset for local development: Kroner then runs an embedded Postgres
# under .data/, with the identical schema, migrations and RLS policies.
# DATABASE_URL=postgresql://user:password@host:5432/kroner

# Public origin, used to build the bank authorization redirect.
# APP_URL=https://kroner.example.com

# ─── AI assistant (optional) ───────────────────────────────────────────────
# Without a key the assistant still answers, using a rule-based intent parser
# over the same read-only queries. The numbers are identical either way.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ─── Open Banking: GoCardless Bank Account Data (optional) ─────────────────
# Free tier at https://bankaccountdata.gocardless.com — covers Danish banks.
# The consent flow is hosted by GoCardless and your bank; Kroner never sees
# MitID, a bank password, or any other authentication factor.
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=
# GOCARDLESS_BASE_URL=https://bankaccountdata.gocardless.com/api/v2

# Swap the Open Banking aggregator without touching anything else.
# BANK_PROVIDER=gocardless

# ─── Stripe (optional) ─────────────────────────────────────────────────────
# Prefer a RESTRICTED key (rk_live_…) with read access to Balance transactions
# and Charges. Kroner reads three endpoints and has no write code path.
# Keys added through the UI are encrypted and stored per user; this variable is
# only a fallback for single-tenant deployments.
# STRIPE_API_KEY=

# ─── Prepared, not yet wired ───────────────────────────────────────────────
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# MOBILEPAY_CLIENT_ID=
# MOBILEPAY_CLIENT_SECRET=
# MOBILEPAY_SUBSCRIPTION_KEY=

# ─── Tuning ────────────────────────────────────────────────────────────────
# EMBEDDED_DB_DIR=.data/pgdata
# PGPOOL_MAX=10
